generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  CLIENT
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  googleId  String?  @unique
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  referralCode String? @unique
  referredById String?
  referredBy   User?   @relation("UserReferrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("UserReferrals")

  extraScratches Int @default(0)

  scratchCards ScratchCard[]
  coupons      Coupon[]

  giveawayParticipations GiveawayParticipation[]
  giveawayFollows        GiveawayFollow[]

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])
}

model Client {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  users     User[]
  campaigns Campaign[]
}

model Campaign {
  id            String        @id @default(cuid())
  name          String
  description   String?
  discount      Decimal       @db.Decimal(10, 2)
  totalCoupons  Int
  issuedCoupons Int           @default(0)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  expiresAt     DateTime?
  scratchCards  ScratchCard[]
  coupons       Coupon[]
  discountType  String        @default("PERCENT")

  oldPrice Decimal? @db.Decimal(10, 2)
  newPrice Decimal? @db.Decimal(10, 2)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])
}

model ScratchCard {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  discount Decimal @db.Decimal(10, 2)

  coupon Coupon?

  scratched Boolean @default(false)

  createdAt   DateTime  @default(now())
  scratchedAt DateTime?
}

model Coupon {
  id String @id @default(cuid())

  code String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  scratchCardId String      @unique
  scratchCard   ScratchCard @relation(fields: [scratchCardId], references: [id])

  discount Decimal @db.Decimal(10, 2)

  used Boolean @default(false)

  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  redeemedAt DateTime?
}

enum GiveawayImportStatus {
  PENDING
  IMPORTED
  DISMISSED
}

model Giveaway {
  id          String    @id @default(cuid())
  title       String
  organizer   String
  prize       String
  description String?
  rules       String?
  originalUrl String
  imageUrl    String?
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean   @default(true)

  winnerAnnouncementUrl String?
  winnerAnnouncedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participations GiveawayParticipation[]
  followers      GiveawayFollow[]

  sourceImport GiveawayImport?
}

model GiveawayParticipation {
  id             String   @id @default(cuid())
  giveawayId     String
  userId         String
  participatedAt DateTime @default(now())

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, userId])
}

model GiveawayFollow {
  id           String   @id @default(cuid())
  giveawayId   String
  userId       String
  notifyWinner Boolean  @default(true)
  createdAt    DateTime @default(now())

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, userId])
}

model GiveawayImport {
  id String @id @default(cuid())

  sourcePostId   String @unique
  sourcePageId   String
  sourcePageName String

  description String?
  imageUrl    String?
  originalUrl String
  publishedAt DateTime?

  status GiveawayImportStatus @default(PENDING)

  importedAt   DateTime  @default(now())
  lastSyncedAt DateTime?
  updatedAt    DateTime  @updatedAt

  giveawayId String?   @unique
  giveaway   Giveaway? @relation(fields: [giveawayId], references: [id], onDelete: SetNull)

  @@index([status, importedAt])
  @@index([sourcePageId])
}
